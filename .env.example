# Bunny Library — environment variable NAMES only (never commit real values).
# Copy this file to .env.local and paste your own values from the Neon dashboard.
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be printed, logged or shared.

# ── Neon PostgreSQL (runtime database) ────────────────────────────────────────
# POOLED connection string (PgBouncer endpoint — hostname contains "-pooler").
# Used by the application at runtime for all queries (serverless-safe).
DATABASE_URL=

# DIRECT (non-pooled) connection string — same Neon project/role, hostname
# WITHOUT "-pooler". Used ONLY by Prisma CLI for versioned migrations and
# administrative commands. Both URLs are required; never mutate a Neon
# hostname by hand — copy both strings directly from the Neon dashboard.
DIRECT_URL=

# ── NextAuth ──────────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET: any long random string. NEXTAUTH_URL: the app origin.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
